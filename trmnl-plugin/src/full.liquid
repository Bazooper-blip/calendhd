{% comment %}
  calenDHD — full screen (TRMNL OG and TRMNL X). Left column: right-now focus
  + today's agenda. Right column: the next few days.

  Sizing: list heights are derived from trmnl.screen.height so the TRMNL X
  (larger logical viewport) shows more items instead of just scaling up.
  On the OG (480) `extra` is 0 and the layout is identical to before; when the
  merge variable is missing (older renderers) we fall back to OG values.
  Portrait mounting (TRMNL X) stacks the two columns vertically.

  All static chrome comes from the feed's `strings` object (localized en/sv
  server-side); `default:` fallbacks keep the plugin working against a
  calenDHD server that predates it.
{% endcomment %}
{% assign today = days | first %}
{% assign screen_w = trmnl.screen.width | default: 800 | plus: 0 %}
{% assign screen_h = trmnl.screen.height | default: 480 | plus: 0 %}
{% assign extra = screen_h | minus: 480 | at_most: 200 | at_least: 0 %}
{% assign today_list_h = 300 | plus: extra %}
{% assign upcoming_list_h = 440 | plus: extra %}
{% assign portrait = false %}
{% if screen_h > screen_w %}
  {% assign portrait = true %}
  {% assign today_list_h = 360 %}
  {% assign upcoming_list_h = 340 %}
{% endif %}

{% comment %}
  The event shown on the NOW/NEXT hero card is skipped in today's list
  (matched by title+time) so it doesn't appear twice. Comparison goes
  through a plain hero_key string — no nil property lookups, no compound
  unless conditions — to stay portable across Liquid engine ports.
{% endcomment %}
{% assign hero_key = "" %}
{% if current_event %}
  {% assign hero_key = current_event.title | append: "|" | append: current_event.time %}
{% elsif next_event %}
  {% assign hero_key = next_event.title | append: "|" | append: next_event.time %}
{% endif %}

{% capture focus_block %}
      {% if current_event %}
        <div class="item">
          <div class="content">
            <span class="label label--small">{{ strings.now | default: "NOW" }}</span>
            <span class="title">{% if current_event.icon != blank %}{{ current_event.icon }} {% endif %}{{ current_event.title }}</span>
            <span class="label label--small label--underline">{{ current_event.time_range }}</span>
            {% if current_event.first_step != blank %}
              <span class="description">{{ strings.start_with | default: "Start with:" }} {{ current_event.first_step }}</span>
            {% endif %}
          </div>
        </div>
      {% elsif next_event %}
        <div class="item">
          <div class="content">
            <span class="label label--small">{{ strings.next | default: "NEXT" }}{% unless next_event.day_label == today.label %} · {{ next_event.day_label }}{% endunless %}</span>
            <span class="title">{% if next_event.icon != blank %}{{ next_event.icon }} {% endif %}{{ next_event.title }}</span>
            <span class="label label--small label--underline">{{ next_event.time_range }}</span>
          </div>
        </div>
      {% else %}
        <div class="item">
          <div class="content">
            <span class="label label--small">{{ strings.now | default: "NOW" }}</span>
            <span class="title">{{ strings.nothing_scheduled | default: "Nothing scheduled" }}</span>
            <span class="description">{{ strings.enjoy_calm | default: "Enjoy the calm." }}</span>
          </div>
        </div>
      {% endif %}

      {% if tasks_total_today > 0 %}
        <span class="label label--small label--gray-out">✓ {{ tasks_done_today }} {{ strings.of | default: "of" }} {{ tasks_total_today }} {{ strings.done_today | default: "done today" }}</span>
      {% endif %}

      <div class="list" data-list-limit="true" data-list-max-height="{{ today_list_h }}" data-list-hidden-count="true">
        {% for ev in today.all_day %}
          <div class="item">
            <div class="content">
              <span class="title title--small">{% if ev.icon != blank %}{{ ev.icon }} {% endif %}{{ ev.title }}</span>
              <span class="label label--small label--gray-out">{{ strings.all_day | default: "All day" }}</span>
            </div>
          </div>
        {% endfor %}
        {% for ev in today.events %}
          {% assign ev_key = ev.title | append: "|" | append: ev.time %}
          {% if ev_key != hero_key %}
          <div class="item">
            <div class="content">
              <span class="title title--small">{% if ev.is_task %}{% if ev.done %}✓ {% else %}○ {% endif %}{% endif %}{% if ev.icon != blank %}{{ ev.icon }} {% endif %}{{ ev.title }}</span>
              <span class="label label--small label--gray-out">{{ ev.time_range }}{% if ev.routine != blank %} · {{ ev.routine }}{% elsif ev.category != blank %} · {{ ev.category }}{% endif %}</span>
            </div>
          </div>
          {% endif %}
        {% endfor %}
        {% if today.event_count == 0 %}
          <div class="item">
            <div class="content">
              <span class="description">{{ strings.no_events | default: "No events today" }}</span>
            </div>
          </div>
        {% endif %}
      </div>
      {% if today.more_count > 0 %}
        <span class="label label--small label--gray-out">+{{ today.more_count }} {{ strings.more | default: "more" }}</span>
      {% endif %}
{% endcapture %}

{% capture upcoming_block %}
      <div class="list" data-list-limit="true" data-list-max-height="{{ upcoming_list_h }}" data-list-hidden-count="true">
        {% for day in days offset: 1 %}
          {% comment %}
            Day header: bold (same visual weight as event titles, so events
            don't outrank their own day), with a thin rule separating day
            blocks. Empty days get a quiet dash so a bare header reads as
            "nothing planned", not as a glitch.
          {% endcomment %}
          {% if forloop.first %}
          <div class="item">
          {% else %}
          <div class="item" style="border-top: 1px solid #555555; margin-top: 10px; padding-top: 8px;">
          {% endif %}
            <div class="content">
              <span class="title title--small">{{ day.label }} · {{ day.date_label }}</span>
            </div>
          </div>
          {% if day.event_count == 0 %}
            <div class="item">
              <div class="content">
                <span class="label label--small label--gray-out">—</span>
              </div>
            </div>
          {% endif %}
          {% for ev in day.all_day limit: 2 %}
            <div class="item">
              <div class="content">
                <span class="title title--small">{% if ev.icon != blank %}{{ ev.icon }} {% endif %}{{ ev.title }}</span>
                <span class="label label--small label--gray-out">{{ strings.all_day | default: "All day" }}</span>
              </div>
            </div>
          {% endfor %}
          {% for ev in day.events limit: 4 %}
            <div class="item">
              <div class="content">
                <span class="title title--small">{% if ev.icon != blank %}{{ ev.icon }} {% endif %}{{ ev.title }}</span>
                <span class="label label--small label--gray-out">{{ ev.time }}</span>
              </div>
            </div>
          {% endfor %}
        {% endfor %}
      </div>
{% endcapture %}

{% if portrait %}
<div class="layout layout--col">
  {{ focus_block }}
  {{ upcoming_block }}
</div>
{% else %}
<div class="layout">
  <div class="columns">
    <div class="column">
      {{ focus_block }}
    </div>
    <div class="column">
      {{ upcoming_block }}
    </div>
  </div>
</div>
{% endif %}

<div class="title_bar">
  <img class="image" src="https://usetrmnl.com/images/plugins/trmnl--render.svg" />
  <span class="title">calenDHD</span>
  <span class="instance">{{ today_label }}</span>
</div>
