{% comment %}
  calenDHD — half horizontal: right-now focus on the left, today's agenda on
  the right. List height scales with trmnl.screen.height (half-height layout,
  so half the extra headroom); identical to the OG layout when the merge
  variable is missing. Chrome strings come localized from the feed.
{% endcomment %}
{% assign today = days | first %}
{% assign screen_h = trmnl.screen.height | default: 480 | plus: 0 %}
{% assign extra = screen_h | minus: 480 | at_most: 200 | at_least: 0 %}
{% assign extra_half = extra | divided_by: 2 %}
{% assign agenda_list_h = 170 | plus: extra_half %}
{% comment %} Hero-card event is skipped in the agenda list (no duplicates). {% endcomment %}
{% assign hero_key = "" %}
{% if current_event %}
  {% assign hero_key = current_event.title | append: "|" | append: current_event.time %}
{% elsif next_event %}
  {% assign hero_key = next_event.title | append: "|" | append: next_event.time %}
{% endif %}

{% comment %} View wrapper: required on BYOS renderers (LaraPaper), harmless nested on TRMNL cloud/trmnlp — see full.liquid. {% endcomment %}
<div class="view view--half_horizontal">
<div class="layout">
  <div class="columns">

    <div class="column">
      {% if current_event %}
        <div class="item">
          <div class="content">
            <span class="label label--small">{{ strings.now | default: "NOW" }}</span>
            <span class="title">{% if current_event.icon != blank %}{{ current_event.icon }} {% endif %}{{ current_event.title }}</span>
            <span class="label label--small label--underline">{{ current_event.time_range }}</span>
          </div>
        </div>
      {% elsif next_event %}
        <div class="item">
          <div class="content">
            <span class="label label--small">{{ strings.next | default: "NEXT" }}{% unless next_event.day_label == today.label %} · {{ next_event.day_label }}{% endunless %}</span>
            <span class="title">{% if next_event.icon != blank %}{{ next_event.icon }} {% endif %}{{ next_event.title }}</span>
            <span class="label label--small label--underline">{{ next_event.time_range }}</span>
          </div>
        </div>
      {% else %}
        <div class="item">
          <div class="content">
            <span class="title">{{ strings.nothing_scheduled | default: "Nothing scheduled" }}</span>
            <span class="description">{{ strings.enjoy_calm | default: "Enjoy the calm." }}</span>
          </div>
        </div>
      {% endif %}
      {% if tasks_total_today > 0 %}
        <span class="label label--small label--gray-out">✓ {{ tasks_done_today }} {{ strings.of | default: "of" }} {{ tasks_total_today }} {{ strings.done_today | default: "done today" }}</span>
      {% endif %}
    </div>

    <div class="column">
      <div class="list" data-list-limit="true" data-list-max-height="{{ agenda_list_h }}" data-list-hidden-count="true">
        {% for ev in today.all_day %}
          <div class="item">
            <div class="content">
              <span class="title title--small">{% if ev.icon != blank %}{{ ev.icon }} {% endif %}{{ ev.title }}</span>
              <span class="label label--small label--gray-out">{{ strings.all_day | default: "All day" }}</span>
            </div>
          </div>
        {% endfor %}
        {% comment %}
          Upcoming events first; finished ones dimmed below an "Earlier today"
          divider (see full.liquid). Old feeds without is_past render as before.
        {% endcomment %}
        {% for ev in today.events %}
          {% assign ev_key = ev.title | append: "|" | append: ev.time %}
          {% if ev_key != hero_key %}
          {% unless ev.is_past %}
          <div class="item">
            <div class="content">
              <span class="title title--small">{% if ev.is_task %}{% if ev.done %}✓ {% else %}○ {% endif %}{% endif %}{% if ev.icon != blank %}{{ ev.icon }} {% endif %}{{ ev.title }}</span>
              <span class="label label--small label--gray-out">{{ ev.time }}</span>
            </div>
          </div>
          {% endunless %}
          {% endif %}
        {% endfor %}
        {% if today.past_count > 0 %}
          <div class="item" style="border-top: 1px solid #555555; margin-top: 10px; padding-top: 8px;">
            <div class="content">
              <span class="label label--small label--gray-out">{{ strings.earlier_today | default: "Earlier today" }}</span>
            </div>
          </div>
          {% for ev in today.events %}
            {% if ev.is_past %}
            <div class="item">
              <div class="content">
                <span class="title title--small" style="opacity: 0.55">{% if ev.is_task %}{% if ev.done %}✓ {% else %}○ {% endif %}{% endif %}{% if ev.icon != blank %}{{ ev.icon }} {% endif %}{{ ev.title }}</span>
                <span class="label label--small label--gray-out">{{ ev.time }}</span>
              </div>
            </div>
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if today.event_count == 0 %}
          <div class="item">
            <div class="content">
              <span class="description">{{ strings.no_events | default: "No events today" }}</span>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://usetrmnl.com/images/plugins/trmnl--render.svg" />
  <span class="title">calenDHD</span>
  <span class="instance">{{ today_label }}</span>
</div>
</div>
